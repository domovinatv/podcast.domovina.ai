---
// Birač dana za desktop: godina → mjesec → kalendar mjeseca (pon–ned). Ćelija dana je
// obojena prema broju epizoda (relativno na najjači dan arhive), pa se ritam vidi i ovdje.
// Podaci dolaze iz /dani/kalendar.json (jedna datoteka za sve stranice); bez JS-a ostaje
// „Idi na datum". Na mobitelu je vidljiv samo „Idi na datum" — traku dana daje DayTimeline.
import { archiveDays } from "../lib/catalog.js";

const { current = "" } = Astro.props;
const first = archiveDays.at(-1).date, last = archiveDays[0].date;
---
<nav class="dp" aria-label="Odaberi dan" data-current={current} data-last={last}>
    <div class="dp-head">
        <a href="/dani/" class="dp-all">Svi dani</a>
        <label class="dp-jump">
            <span>Idi na datum</span>
            <input type="date" min={first} max={last} value={current || last} />
        </label>
    </div>
    <div class="dp-body"></div>
</nav>
<script>
    const MON = ["siječanj", "veljača", "ožujak", "travanj", "svibanj", "lipanj", "srpanj", "kolovoz", "rujan", "listopad", "studeni", "prosinac"];
    const MON_S = ["sij", "velj", "ožu", "tra", "svi", "lip", "srp", "kol", "ruj", "lis", "stu", "pro"];
    const WD = ["pon", "uto", "sri", "čet", "pet", "sub", "ned"];
    const dp = document.querySelector(".dp");

    dp?.querySelector(".dp-jump input").addEventListener("change", e => {
        if (e.target.value) location.href = `/dani/${e.target.value}/`;
    });

    function el(tag, attrs = {}, ...kids) {
        const n = document.createElement(tag);
        for (const [k, v] of Object.entries(attrs)) {
            if (v == null || v === false) continue;
            if (k === "class") n.className = v; else if (k === "style") n.setAttribute("style", v); else n.setAttribute(k, v);
        }
        n.append(...kids.filter(k => k != null));
        return n;
    }

    if (dp && matchMedia("(min-width: 900px)").matches) {
        fetch("/dani/kalendar.json").then(r => r.json()).then(({ max, days }) => {
            const counts = new Map(days);
            const current = dp.dataset.current;
            const months = [...new Set(days.map(([d]) => d.slice(0, 7)))];
            const years = [...new Set(months.map(m => m.slice(0, 4)))];
            const monthTotal = m => days.reduce((s, [d, c]) => s + (d.startsWith(m) ? c : 0), 0);
            let month = (current || dp.dataset.last).slice(0, 7);
            const body = dp.querySelector(".dp-body");

            function render() {
                const year = month.slice(0, 4);
                const yearsEl = el("div", { class: "dp-years", role: "group", "aria-label": "Godina" },
                    ...years.map(y => el("button", { type: "button", "data-year": y, "aria-pressed": String(y === year) }, y)));
                const monthsEl = el("div", { class: "dp-months" }, ...MON_S.map((label, i) => {
                    const key = `${year}-${String(i + 1).padStart(2, "0")}`;
                    return months.includes(key)
                        ? el("button", { type: "button", "data-month": key, "aria-pressed": String(key === month) }, el("span", {}, label), el("small", {}, String(monthTotal(key))))
                        : el("span", { class: "dp-off" }, label);
                }));
                const [y, mo] = month.split("-").map(Number);
                const n = new Date(Date.UTC(y, mo, 0)).getUTCDate();
                const lead = (new Date(Date.UTC(y, mo - 1, 1)).getUTCDay() + 6) % 7;
                const cells = [...WD.map(w => el("span", { class: "dp-wd" }, w)), ...Array.from({ length: lead }, () => el("span"))];
                for (let d = 1; d <= n; d++) {
                    const date = `${month}-${String(d).padStart(2, "0")}`;
                    const c = counts.get(date);
                    if (c == null) { cells.push(el("span", { class: "dp-day dp-none" }, el("b", {}, String(d)))); continue; }
                    const h = c / max;
                    cells.push(el("a", {
                        href: `/dani/${date}/`, class: `dp-day${h > 0.55 ? " dp-hot" : ""}${date === current ? " dp-cur" : ""}`,
                        style: `--h:${h.toFixed(2)}`, title: `${c} epizoda`, "aria-current": date === current ? "page" : null,
                    }, el("b", {}, String(d)), el("small", {}, String(c))));
                }
                const idx = months.indexOf(month);
                const cal = el("div", { class: "dp-cal" },
                    el("div", { class: "dp-cal-head" },
                        el("button", { type: "button", class: "dp-step", "data-step": "-1", "aria-label": "Prethodni mjesec", disabled: idx <= 0 }, "‹"),
                        el("span", {}, el("b", {}, `${MON[mo - 1]} ${y}.`), " ", el("small", { class: "muted" }, `${monthTotal(month)} ep.`)),
                        el("button", { type: "button", class: "dp-step", "data-step": "1", "aria-label": "Sljedeći mjesec", disabled: idx >= months.length - 1 }, "›")),
                    el("div", { class: "dp-grid" }, ...cells));
                const legend = el("p", { class: "dp-legend", "aria-hidden": "true" }, el("span", {}, "manje"),
                    ...[0.1, 0.35, 0.6, 0.9].map(h => el("i", { style: `--h:${h}` })), el("span", {}, "više epizoda"));
                body.replaceChildren(yearsEl, monthsEl, cal, legend);
            }

            body.addEventListener("click", e => {
                const yb = e.target.closest("button[data-year]");
                if (yb) {
                    const y = yb.dataset.year;
                    // Godina trenutnog dana → njegov mjesec; druga godina → njen zadnji mjesec s epizodama.
                    month = current && current.startsWith(y) ? current.slice(0, 7) : months.filter(m => m.startsWith(y)).at(-1);
                    return render();
                }
                const mb = e.target.closest("button[data-month]");
                if (mb) { month = mb.dataset.month; return render(); }
                const st = e.target.closest(".dp-step");
                if (st) { const next = months[months.indexOf(month) + Number(st.dataset.step)]; if (next) { month = next; render(); } }
            });
            render();
        });
    }
</script>
