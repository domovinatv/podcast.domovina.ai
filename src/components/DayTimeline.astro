---
// Vodoravna traka dana za mobitel (najnoviji lijevo); na desktopu je skrivena — tamo je DayPicker.
import { archiveDays } from "../lib/catalog.js";

const { current } = Astro.props;
const WD = ["ned", "pon", "uto", "sri", "čet", "pet", "sub"];
const MONTHS = ["Siječanj", "Veljača", "Ožujak", "Travanj", "Svibanj", "Lipanj", "Srpanj", "Kolovoz", "Rujan", "Listopad", "Studeni", "Prosinac"];
const max = Math.max(1, ...archiveDays.map(d => d.count));

// Traka nosi ±45 dana oko odabranog (dalje se skače nativnim „Idi na datum" iz DayPicker),
// inače bi svaka od stotina dnevnih stranica nosila cijelu arhivu.
const ci = Math.max(0, archiveDays.findIndex(d => d.date === current));
const items = [];
for (const d of archiveDays.slice(Math.max(0, ci - 45), ci + 46)) {
    const [y, m, dd] = d.date.split("-").map(Number);
    const month = `${MONTHS[m - 1]} ${y}.`;
    if (items.at(-1)?.month !== month) items.push({ month, days: [] });
    items.at(-1).days.push({ ...d, day: dd, wd: WD[new Date(Date.UTC(y, m - 1, dd)).getUTCDay()], weekend: [0, 6].includes(new Date(Date.UTC(y, m - 1, dd)).getUTCDay()) });
}
---
<nav class="tl" aria-label="Odaberi dan">
    <a href="/dani/" class="tl-all">Svi dani</a>
    {items.map(g => (
        <div class="tl-month">
            <h3>{g.month}</h3>
            <ol>
                {g.days.map(d => (
                    <li>
                        <a href={`/dani/${d.date}/`} class:list={["tl-day", { "tl-we": d.weekend }]} aria-current={d.date === current ? "page" : undefined} title={`${d.count} epizoda`}>
                            <span class="tl-dot" aria-hidden="true"></span>
                            <span class="tl-date"><b>{d.day}.</b> {d.wd}</span>
                            <span class="tl-bar" aria-hidden="true"><span style={`width:${Math.round((d.count / max) * 100)}%`}></span></span>
                            <span class="tl-n">{d.count}</span>
                        </a>
                    </li>
                ))}
            </ol>
        </div>
    ))}
</nav>
<script>
    // Odabrani dan u vidljivi dio timelinea (bitno kad arhiva naraste na mjesece).
    const cur = document.querySelector('.tl [aria-current="page"]');
    cur?.scrollIntoView({ block: "center", inline: "center" });
    window.scrollTo(0, 0);
</script>
