---
// Jedan kanal u katalogu: avatar, ime, svježina. Klik otvara detalj u dijalogu
// (src/scripts/app.js); bez JS-a vodi na trajnu stranicu /p/<slug>/.
import { shortDate, compactNumber, episodeCountLabel, ACTIVITY_LABEL } from "../lib/catalog.js";
import Avatar from "./Avatar.astro";

const { p } = Astro.props;
const fold = s => s.normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/đ/g, "d").toLowerCase();
const eps = episodeCountLabel(p);
const q = fold([p.name, ...p.hosts, ...p.tags].join(" "));
---
<li
    class="row"
    data-slug={p.slug}
    data-act={p.activity}
    data-dom={p.onDomovina ? "1" : undefined}
    data-last={p.last || ""}
    data-f={p.followers ?? 0}
    data-q={q}
>
    <a href={`/p/${p.slug}/`} class="row-link" title={`${p.name} — ${ACTIVITY_LABEL[p.activity]}`}>
        <Avatar p={p} size={30} />
        <span class="row-name">{p.name}</span>
        {eps ? <span class="row-eps" title="Ukupno epizoda">{eps}</span> : null}
        {p.onDomovina && <span class="dom-dot" title="Na domovina.ai: članci, poglavlja, pretraga">D</span>}
        <span class={`row-when act-${p.activity}`}>
            {p.last ? <time datetime={p.last} data-rel>{shortDate(p.last)}</time> : <span class="row-date">—</span>}
            <span class="row-fol" title="Pratitelja">{compactNumber(p.followers) ?? "—"}</span>
        </span>
    </a>
</li>
