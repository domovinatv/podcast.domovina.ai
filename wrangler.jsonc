{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "podcast-domovina-ai",
  "compatibility_date": "2026-09-01",
  // D.O.M. račun — isti kao glazba.domovina.ai i podcast-registry (CF Pages).
  "account_id": "7dc7167b7e2e00923bfa7cd697df14e4",

  // Samo statika, bez Worker koda: Cloudflare servira dist/ izravno s edgea.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },

  "routes": [
    { "pattern": "podcast.domovina.ai", "custom_domain": true }
  ]
}
