{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "podcast-domovina-ai",
  "compatibility_date": "2026-09-01",
  // D.O.M. račun — isti kao glazba.domovina.ai i podcast-registry (CF Pages).
  "account_id": "7dc7167b7e2e00923bfa7cd697df14e4",

  // Statika iz dist/ ide izravno s edgea. Worker (worker/index.js) se pali SAMO za
  // stranicu epizode /p/<slug>/v/<id> (run_worker_first), ostalo ga ne dotiče.
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/p/*/v/*"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },

  "routes": [
    { "pattern": "podcast.domovina.ai", "custom_domain": true }
  ]
}
